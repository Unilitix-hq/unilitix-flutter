    {
      "id": "retry.401-pauses-until-next-init",
      "description": "401 keeps the data and pauses uploads for the life of the process; the next init (after restart) uploads it.",
      "steps": [
        {
          "init": {}
        },
        {
          "track": {
            "name": "a"
          }
        },
        {
          "serverResponds": {
            "status": 401,
            "times": 1
          }
        },
        {
          "flush": {}
        },
        {
          "expectRequests": [
            {
              "path": "/v1/ingest/session",
              "status": 401,
              "body": {
                "events": [
                  {
                    "type": "SESSION_START",
                    "eventId": {
                      "$capture": "e0"
                    }
                  },
                  {
                    "type": "CUSTOM",
                    "eventId": {
                      "$capture": "e1"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "expectState": {
            "queueLength": 2
          }
        },
        {
          "expectState": {
            "uploadsPaused": true
          }
        },
        {
          "advanceTime": {
            "ms": 3600000
          }
        },
        {
          "flush": {}
        },
        {
          "expectRequests": []
        },
        {
          "expectState": {
            "queueLength": 2
          }
        },
        {
          "restart": {}
        },
        {
          "init": {}
        },
        {
          "flush": {}
        },
        {
          "expectEvents": {
            "mode": "contains",
            "events": [
              {
                "eventId": {
                  "$eq": "e0"
                }
              },
              {
                "eventId": {
                  "$eq": "e1"
                }
              }
            ]
          }
        },
        {
          "expectState": {
            "uploadsPaused": false
          }
        }
      ]
    },
