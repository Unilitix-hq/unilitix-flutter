{
  "kind": "behaviour",
  "area": "retry",
  "description": "Upload outcome classification (sdk-contract retry): retry with backoff, auth pause, payment pause, drop.",
  "cases": [
    {
      "id": "retry.5xx-keeps-batch-and-backs-off",
      "description": "5xx keeps the batch and opens a backoff window of baseDelayMs (+0-20% jitter) during which flushes, including app-called ones, send nothing; the retry resends the same events (same eventId).",
      "steps": [
        {
          "init": {}
        },
        {
          "track": {
            "name": "a"
          }
        },
        {
          "serverResponds": {
            "status": 503,
            "times": 1
          }
        },
        {
          "flush": {}
        },
        {
          "expectRequests": [
            {
              "path": "/v1/ingest/session",
              "status": 503,
              "body": {
                "events": [
                  {
                    "type": "SESSION_START",
                    "eventId": {
                      "$capture": "e0"
                    }
                  },
                  {
                    "type": "CUSTOM",
                    "eventId": {
                      "$capture": "e1"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "expectState": {
            "queueLength": 2
          }
        },
        {
          "flush": {}
        },
        {
          "expectRequests": []
        },
        {
          "advanceTime": {
            "ms": 1300
          }
        },
        {
          "flush": {}
        },
        {
          "expectRequests": [
            {
              "path": "/v1/ingest/session",
              "status": 202,
              "body": {
                "events": [
                  {
                    "eventId": {
                      "$eq": "e0"
                    }
                  },
                  {
                    "eventId": {
                      "$eq": "e1"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "expectState": {
            "queueLength": 0
          }
        }
      ]
    },
