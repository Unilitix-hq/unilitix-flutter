                    "eventId": {
                      "$capture": "e0"
                    }
                  },
                  {
                    "type": "CUSTOM",
                    "eventId": {
                      "$capture": "e1"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "expectState": {
            "queueLength": 0
          }
        },
        {
          "track": {
            "name": "b"
          }
        },
        {
          "flush": {}
        },
        {
          "expectRequests": [
            {
              "path": "/v1/ingest/session",
              "status": 202,
              "body": {
                "events": [
                  {
                    "type": "CUSTOM",
                    "metadata": {
                      "name": "b"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
