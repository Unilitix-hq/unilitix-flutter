    {
      "id": "retry.other-4xx-drops-batch",
      "description": "Any other 4xx (400, 404, 409, 413, 422) drops that batch with no backoff: the next flush sends only newer events, immediately.",
      "steps": [
        {
          "init": {}
        },
        {
          "track": {
            "name": "a"
          }
        },
        {
          "serverResponds": {
